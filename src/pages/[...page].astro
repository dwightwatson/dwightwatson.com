---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Post from "../components/Post.astro";
import Pagination from "../components/Pagination.astro";

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("posts")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  return paginate(posts, { pageSize: 25 });
}

const { page } = Astro.props;

const title =
  page.currentPage === 1
    ? "Dwight Watson's Blog"
    : `Dwight Watson's Blog - page ${page.currentPage}`;
---

<Base
  title={title}
  description="A blog on Laravel, Ruby on Rails & general web development, by Dwight Watson."
  isHome
>
  <div class="flex flex-col gap-8 mb-8">
    {page.data.map((post) => <Post post={post} />)}
  </div>

  <Pagination page={page} class="mb-8" />
</Base>
